{
  "name": "hn-digest-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scrapes the top 5 Hacker News stories, extracts article text with Readability, summarizes with gpt-4o-mini, and prints a markdown digest.",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.5.0",
    "cheerio": "^1.0.0",
    "jsdom": "^24.1.0",
    "openai": "^4.55.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
